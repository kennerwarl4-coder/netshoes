# Credenciais da API SigiloPay
# Obtenha no painel: Integrações -> API -> Gerar credenciais
SIGILOPAY_PUBLIC_KEY=
SIGILOPAY_SECRET_KEY=

# URL base oficial da API SigiloPay
SIGILOPAY_BASE_URL=https://app.sigilopay.com.br/api/v1

# URL pública da sua aplicação para webhook (ex: https://seu-dominio.vercel.app)
# Deixe vazio em dev local ou defina com sua URL de produção / ngrok
WEBHOOK_BASE_URL=
